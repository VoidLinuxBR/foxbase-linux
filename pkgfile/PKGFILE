pkgname=foxbase-linux
pkgdesc="FoxBASE Linux - ambiente xBase em terminal inspirado no FoxBASE+ para DOS (DBF, BROWSE, PRG)"
pkgver=0.4.0   # = APP_VERSION (usr/lib/foxbase-linux/foxbase_linux/__init__.py); atualizar a cada release
pkgrel=1
arch=('any')
license=('MIT')
#url="ssh://git@github.com/voidlinuxbr/${pkgname}"
url="https://github.com/voidlinuxbr/${pkgname}"
source=("git+${url}.git")
md5sums=('SKIP')
makedepends=()
depends=(
	'python3'         # >= 3.9 (curses da biblioteca padrão)
)
# opcionais (detectados em tempo de execução, não são dependência):
#   harbour (hbrun, hbmk2) -> comandos/funções do Harbour no ponto (ALERT() etc.)
#                            e DO programa (compila com hbmk2)
backup=()

package() {
	# Verify default folder
	if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}/${pkgname}"
	elif [ -d "${srcdir}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}"
	else
		#local
		InternalDir="${WORKDIR}"
	fi

	cd "${InternalDir}"
	# Copiar a estrutura de /etc, /usr e /opt para /
	local dirs=("boot" "etc" "opt" "usr" "var")
	for dir in "${dirs[@]}"; do
		if [ -d "${InternalDir}/${dir}" ]; then
			cp -a "${InternalDir}/${dir}" "${pkgdir}/"
		fi
	done

	# executáveis (o git pode não preservar o bit +x em todos os fluxos)
	chmod 755 "${pkgdir}/usr/bin/foxbase-linux"

	# sem bytecode/caches do repositório
	find "${pkgdir}/usr/lib/foxbase-linux" -name '__pycache__' -type d -prune -exec rm -rf {} +

	# Install license file if present
	if [ -f "LICENSE" ]; then
		install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	fi

	# Install documentation if present
	if [ -f "README.md" ]; then
		install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
	fi
}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	log "Finalizando instalação"
	echo "==> foxbase-linux instalado."
	echo "    Iniciar:   foxbase-linux [arquivo.dbf | programa.prg]"
	echo "    Exemplos:  /usr/share/foxbase-linux/exemplos"
	echo "    Programas .prg (F5 / DO) precisam do Harbour (hbmk2)."
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	log "Finalizando upgrade"
}
