import curses
import locale
import os
import sys

# instalado: /usr/lib/foxbase-linux ; no repositório: ../lib/foxbase-linux
_base = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib", "foxbase-linux")
sys.path.insert(0, os.path.normpath(_base) if os.path.isdir(_base) else "/usr/lib/foxbase-linux")

os.environ.setdefault("ESCDELAY", "25")
locale.setlocale(locale.LC_ALL, "")

from foxbase_linux import APP_VERSION  # noqa: E402
from foxbase_linux.app import FoxBaseApp  # noqa: E402


def main(stdscr):
    FoxBaseApp(stdscr, sys.argv[1:]).run()


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] in ("-V", "--version"):
        print(f"foxbase-linux {APP_VERSION}")
        sys.exit(0)
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print("uso: foxbase-linux [arquivo.dbf | programa.prg]")
        sys.exit(0)
    curses.wrapper(main)
